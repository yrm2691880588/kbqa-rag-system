# ===== docker-compose 环境变量模板（可提交仓库）=====
# 使用方法：把本文件复制为同目录 .env（.env 已被 git 忽略，不会上传）：
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Mac/Linux)
# 然后按需修改密码。docker compose 会自动读取同目录 .env 注入给 PostgreSQL。
# 注意：backend/.env 的 DATABASE_URL 需与此处密码保持一致，后端才能连上数据库。

POSTGRES_USER=kbqa
POSTGRES_PASSWORD=请改成你的本地数据库密码
POSTGRES_DB=kbqa
