# ============================================================
# 生产环境配置模板（部署到服务器时使用）
# ------------------------------------------------------------
# 用法：
#   1. 复制本文件为 backend/.env
#   2. 把下面所有 <尖括号> 里的内容替换成真实值（见每项说明）
#   3. 生成密钥的命令：
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#   4. 启动后若配置有问题，后端会**拒绝启动**并在日志里列出原因
#      （这是有意设计：宁可起不来，也不要带着漏洞上线）
# ============================================================

# ---- 运行环境（必须为 prod，才会启用严格自检）----
APP_ENV=prod

# 日志级别：INFO（排查问题时可临时改 DEBUG）
LOG_LEVEL=INFO

# 是否暴露接口文档（/docs）。生产建议 false，避免接口结构对外泄露
EXPOSE_DOCS=false

# ---- 安全：登录令牌签名密钥（**必填**，至少 32 位随机字符）----
# 不填或仍用示例值 → 生产环境直接拒绝启动
SECRET_KEY=<用上方命令生成一串随机字符填这里>

# ---- 数据库（**必填**）----
# 用户名/密码需与根目录 .env 中 POSTGRES_* 保持一致；主机名用 compose 服务名 postgres
DATABASE_URL=postgresql+asyncpg://kbqa:<数据库强密码>@postgres:5432/kbqa

# ---- 首位管理员账号（首次启动自动创建；密码请用强密码）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<管理员强密码，至少8位且含字母和数字>

# ---- 允许跨域的前端地址（**必填**，填真实域名）----
CORS_ORIGINS=["https://<你的域名>"]

# ---- 对话模型（**必填**）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=<DeepSeek 的 API Key>
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
# 压测专用开关，生产必须为 false（为 true 时启动自检会拒绝启动）
LLM_MOCK=false

# ---- 向量模型（**必填**）----
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=<阿里云百炼的 API Key>
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# ---- 向量库（容器内部走服务名）----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kb_chunks

# ---- 上传文件落盘目录（容器内固定为 /app/data/uploads）----
UPLOAD_DIR=data/uploads

# ---- 短信通道（**必填，且不能再用 mock**）----
# 为什么不能再用 mock：mock 通道的验证码是固定值 123456。
# 带着它上线 = 任何人输入 123456 就能以任意手机号登录。
# 所以生产环境下 SMS_PROVIDER=mock 会让后端**直接拒绝启动**（这是有意设计，不是故障）。
# 三选一：
#   webhook = 通用 HTTP 短信网关（国内多数短信代理商、企业自建网关都是这种，适配面最广）
#   aliyun  = 阿里云短信（需先在控制台报备短信签名与模板，并等审核通过）
SMS_PROVIDER=webhook

# --- 选 webhook 时填这里 ---
# URL 占位符：{phone} 手机号、{code} 验证码、{text} 整条短信内容
SMS_WEBHOOK_URL=https://<短信网关地址>/send?apikey=<网关给你的key>&mobile={phone}&content={text}
SMS_WEBHOOK_METHOD=GET
# POST 时若网关要求自定义请求体，填 JSON 模板（同样支持占位符）；留空则按 phone/code/text 表单字段发
SMS_WEBHOOK_BODY=
# 网关若要求密钥放请求头，填 JSON，例如 {"Authorization":"Bearer xxx"}
SMS_WEBHOOK_HEADERS=
# 调短信服务商的超时（秒）：发不出去要尽快失败，别让用户干等
SMS_TIMEOUT_SECONDS=8

# --- 选 aliyun 时填这里（五项都要，签名与模板必须已审核通过）---
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_REGION=cn-hangzhou

# ---- 登录安全参数（保持默认即可）----
SMS_CODE_TTL_MINUTES=5
SMS_COOLDOWN_SECONDS=60
SMS_DAILY_LIMIT=10
CAPTCHA_TTL_MINUTES=5
REGISTER_MAX_PER_IP_HOUR=3
LOGIN_FAIL_LOCK_COUNT=5
LOGIN_FAIL_LOCK_MINUTES=15
LOGIN_IP_FAIL_LIMIT=20

# ---- 检索参数（保持默认即可）----
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=16
RETRIEVAL_SCORE_THRESHOLD=0.45
RETRIEVAL_MARGIN_RATIO=0.72
RETRIEVAL_MAX_DOCS=3
RETRIEVAL_CHUNKS_PER_DOC=2
LLM_MAX_HISTORY_ROUNDS=8
LLM_MAX_TOKENS=2048

# ---- 可调参数（按客户/环境需要改，改完重启即可）----
# 单次上传文件大小上限（MB）
# ⚠️ 改这个必须同步改 nginx 的 client_max_body_size（当前 120m），否则大文件会被 nginx 先拦掉
MAX_UPLOAD_MB=100
# 检索最多引用几篇不同文档（防引用列表变成长杂货单）
RETRIEVAL_MAX_DOCS=3
# 对话模型超时（秒）：总超时给得宽（长文档总结跑很久），建连超时给得短（网络不通要快点暴露）
LLM_REQUEST_TIMEOUT=120
LLM_CONNECT_TIMEOUT=15
# 健康探活超时（秒）：单项超时 / 探大模型那一步的超时
HEALTH_CHECK_TIMEOUT=5
HEALTH_LLM_PROBE_TIMEOUT=15

# ---- 数据库连接池（P2-17）----
# ⚠️ 这里有道必须算对的乘法：连接总量 = WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#    它必须小于数据库的 max_connections（PostgreSQL 默认 100），
#    否则高峰期会连不上数据库（平时完全正常，属于最难查的故障）。
#    启动自检会把这个算式的结果打在日志里；超了会明确警告。
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
# 数据库端允许的最大连接数（改了这个值，请同步改 PostgreSQL 的 max_connections）
DB_MAX_CONNECTIONS=100

# ---- 数据清理与归档（P2-22）----
# 问答日志/聊天消息保留多少天；超出的由 `python scripts/maintenance.py` 清理（删前先归档）
# 保留期必须 ≥ 1；填 0 或负数会被当成配置写错，自动回退到 180 天（宁可多留，不要误删）
LOG_RETENTION_DAYS=180
MESSAGE_RETENTION_DAYS=180
# 归档目录（要删的内容先导出到这里，一个文件一类数据，JSONL 格式）
ARCHIVE_DIR=data/archive

# ---- AI 调用治理（P2-16）----
# 每分钟最多提问几次（0=不限）。防"某一分钟涌进大量请求"把大模型接口打出 429
AI_RATE_LIMIT_PER_MINUTE=0
# 熔断：连续失败几次就跳闸；跳闸后这段时间内直接快速失败（不再去调大模型）
# 为什么需要：外部接口坏了时，每个请求都干等两分钟才失败，会把工作线程占满 ——
# "大模型挂了"会变成"我们网站也打不开了"。快速失败至少能保住网站本身能打开。
AI_CB_ENABLED=true
AI_CB_FAIL_THRESHOLD=5
AI_CB_OPEN_SECONDS=60
AI_CB_HALF_OPEN_TRIALS=1
# 问题缓存：同样的问题直接返回上次答案（省一次检索 + 一次模型调用）
# 默认 false —— 知识库更新频繁时缓存会答"老话"；内部资料常年不变的场景建议开
QA_CACHE_ENABLED=false
QA_CACHE_TTL_SECONDS=3600
QA_CACHE_MAX_ENTRIES=500

# ---- 文档解析队列（P2-15）----
# 由工作进程从数据库任务表里领活干：进程重启任务不丢、多进程不会重复解析同一个文档
INGESTION_WORKER_ENABLED=true
INGESTION_POLL_SECONDS=2
INGESTION_MAX_ATTEMPTS=3
INGESTION_STALE_SECONDS=900

# ---- 日志（P2-19）----
# text = 人看的（本机开发）；json = 日志系统看的（能被 ELK/Loki 直接按字段检索）
# 两种格式都会自动给每条日志加"请求编号"，并对密钥/手机号做脱敏（不可关闭）
LOG_FORMAT=text
