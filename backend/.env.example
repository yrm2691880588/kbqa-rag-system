# ===== 后端环境变量示例 =====
# 复制本文件为 .env 并填入真实值（.env 含密钥，切勿提交到 git/发给别人）

# 应用基础信息
APP_NAME=KBQA-RAG
DEBUG=true
API_PREFIX=/api/v1

# ---- 业务数据库 ----
# 主方案：PostgreSQL（由 docker-compose 启动）
DATABASE_URL=postgresql+asyncpg://kbqa:kbqa_dev_pw@127.0.0.1:5432/kbqa
# 轻量降级方案（无需 Docker，把上面这行注释掉、启用下面这行）：
# DATABASE_URL=sqlite+aiosqlite:///./data/kbqa.db

# ---- 安全 ----
# 请生成足够长的随机密钥（生产环境必改）：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 初始化管理员 ----
ADMIN_USERNAME=pjs
ADMIN_PASSWORD=123456

# ---- CORS（前端开发服务器地址）----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LOG_LEVEL=INFO

# ===================== AI 服务配置 =====================
# 说明：.env 里的值都在 backend/app/core/config.py 中对应（字段名不区分大小写）

# --- 向量模型：阿里云百炼 DashScope（OpenAI 兼容协议）---
# 到百炼控制台创建 API Key：https://bailian.console.aliyun.com/ (模型广场 → API-KEY 管理)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-你的百炼Key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60

# --- 对话模型：DeepSeek 官方（M3 问答用）---
# 到 https://platform.deepseek.com 创建 API Key
# 现行模型名：deepseek-v4-flash（快速）/ deepseek-v4-pro（更强）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的DeepSeekKey
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
# 压测专用开关：=true 时不调 DeepSeek，改发本地模拟流式回答（不花钱）。日常使用保持 false 或删除
LLM_MOCK=false

# --- 重排模型（M4 检索精度优化用，预留）---
RERANK_API_KEY=
RERANK_MODEL=
