# ===== 后端环境变量示例 =====
# 复制本文件为 .env 并填入真实值（.env 含密钥，切勿提交到 git/发给别人）

# 应用基础信息
APP_NAME=KBQA-RAG
DEBUG=true
API_PREFIX=/api/v1

# ---- 业务数据库 ----
# 主方案：PostgreSQL（由 docker-compose 启动）
DATABASE_URL=postgresql+asyncpg://kbqa:kbqa_dev_pw@127.0.0.1:5432/kbqa
# 轻量降级方案（无需 Docker，把上面这行注释掉、启用下面这行）：
# DATABASE_URL=sqlite+aiosqlite:///./data/kbqa.db

# ---- 安全 ----
# 请生成足够长的随机密钥（生产环境必改）：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 初始化管理员 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- CORS（前端开发服务器地址）----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

LOG_LEVEL=INFO

# ---- 登录安全 / 短信验证码 ----
# 短信供应商：mock=不真发短信，验证码固定 123456（本地开发测试用，不用花钱）
#            aliyun=接阿里云短信（上线前再改，需配下方 KEY 与签名）
SMS_PROVIDER=mock
# 图形验证码有效期（分钟）、短信码有效期（分钟）
CAPTCHA_TTL_MINUTES=5
SMS_CODE_TTL_MINUTES=5
# 防短信轰炸：同一手机号重发间隔(秒) / 每天上限
SMS_COOLDOWN_SECONDS=60
SMS_DAILY_LIMIT=10
# 防批量注册：同一 IP 每小时最多注册几个账号
REGISTER_MAX_PER_IP_HOUR=3
# 防撞库：同一账号连续输错 N 次锁定 N 分钟；同一 IP 累计错 N 次也锁定
LOGIN_FAIL_LOCK_COUNT=5
LOGIN_FAIL_LOCK_MINUTES=15
LOGIN_IP_FAIL_LIMIT=20

# ===================== AI 服务配置 =====================
# 说明：.env 里的值都在 backend/app/core/config.py 中对应（字段名不区分大小写）

# --- 向量模型：阿里云百炼 DashScope（OpenAI 兼容协议）---
# 到百炼控制台创建 API Key：https://bailian.console.aliyun.com/ (模型广场 → API-KEY 管理)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-你的百炼Key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60

# --- 对话模型：DeepSeek 官方（M3 问答用）---
# 到 https://platform.deepseek.com 创建 API Key
# 现行模型名：deepseek-v4-flash（快速）/ deepseek-v4-pro（更强）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的DeepSeekKey
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
# 压测专用开关：=true 时不调 DeepSeek，改发本地模拟流式回答（不花钱）。日常使用保持 false 或删除
LLM_MOCK=false

# --- 重排模型（P2-21 检索精度优化；填了 key 和 model 就启用，留空就自动跳过）---
# 说明：向量检索是"粗筛"，重排是"精挑"——把粗筛出来的候选交给一个小模型逐条判断
#      "这条到底能不能回答问题"，再重新排序。开了之后引用命中率通常会明显提升。
# 建议模型：gte-rerank-v2（阿里云百炼，和向量化同一家，少签一份合同、少管一个 key）
RERANK_API_KEY=
RERANK_MODEL=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 重排超时（秒）。超时或报错一律"跳过重排、用原顺序"，绝不会因此让问答失败
RERANK_TIMEOUT_SECONDS=10

# --- 可调参数（按需改，改完重启后端即可）---
# 单次上传文件大小上限（MB）。改大要同步改 nginx 的 client_max_body_size（当前 120m）
MAX_UPLOAD_MB=100
# 对话模型超时（秒）：总超时 / 建连超时
LLM_REQUEST_TIMEOUT=120
LLM_CONNECT_TIMEOUT=15
# 健康探活超时（秒）：单项 / 探大模型那一步
HEALTH_CHECK_TIMEOUT=5
HEALTH_LLM_PROBE_TIMEOUT=15

# --- 数据库连接池（P2-17；本地开发保持默认即可）---
# 连接总量 = WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW)，必须小于数据库的 max_connections
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
DB_MAX_CONNECTIONS=100
